# ============================================
# Stars & Premium sotuvchi bot — muhit sozlamalari
# Lokal ishga tushirishda: cp .env.example .env
# Railway'da: bu qiymatlarni "Variables" bo'limiga kiriting (fayl sifatida emas!)
# ============================================

# --- Majburiy sozlamalar ---

# @BotFather'dan olingan bot tokeni (https://t.me/BotFather -> /newbot)
BOT_TOKEN=123456789:AAExampleTokenHere

# Admin(lar)ning Telegram user ID raqamlari, vergul bilan ajratilgan (bo'sh joysiz)
# ID'ni bilish uchun @userinfobot ga /start yozing
ADMIN_IDS=111111111,222222222

# --- Karta orqali to'lov rekvizitlari ---
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=F.I.Sh.
